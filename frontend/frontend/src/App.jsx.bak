  )
};

// Domain icon mapper
const getDomainIcon = (iconName) => Icons[iconName] || Icons.sparkles;

function App() {
  // State management
  const [selectedDomain, setSelectedDomain] = useState(null);
  const [goal, setGoal] = useState('');
  const [isRunning, setIsRunning] = useState(false);
  const [agents, setAgents] = useState([]);
  const [feedItems, setFeedItems] = useState([]);
  const [messages, setMessages] = useState([]);
  const [output, setOutput] = useState(null);
  const [showDomains, setShowDomains] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [chatHistory, setChatHistory] = useState([
    { id: 1, title: 'YouTube video strategy for tech reviews', date: '2 hours ago', domain: 'youtube' },
    { id: 2, title: 'Legal contract review for startup', date: 'Yesterday', domain: 'legal' },
    { id: 3, title: 'React app development project', date: '3 days ago', domain: 'development' },
    { id: 4, title: 'Market research for SaaS product', date: 'Last week', domain: 'business' },
    { id: 5, title: 'Content marketing campaign Q1', date: '2 weeks ago', domain: 'content' }
  ]);
  const [activeChatId, setActiveChatId] = useState(null);
  const [connectionStatus, setConnectionStatus] = useState({
    gemini: true,
    redis: true,
    database: true
  });

  const feedRef = useRef(null);
  const goalInputRef = useRef(null);

  // Auto-scroll feed
  useEffect(() => {
    if (feedRef.current) {
      feedRef.current.scrollTop = feedRef.current.scrollHeight;
    }
  }, [feedItems]);

  // Simulation logic
  const runSimulation = useCallback(async (domain, userGoal) => {
    const domainData = DOMAINS.find(d => d.id === domain);
    if (!domainData) return;

    setIsRunning(true);
    setFeedItems([]);
    setAgents([]);
    setMessages([]);
    setOutput(null);

    // Add initial system message
    addFeedItem('system', 'System', `Launching ${domainData.name} team for: "${userGoal}"`);

    // Simulate agent spawning
    for (let i = 0; i < domainData.agents.length; i++) {
      const agentName = domainData.agents[i];

      // Spawn animation
      await new Promise(resolve => setTimeout(resolve, 300));
      spawnAgent(agentName, i);
      addFeedItem('success', 'System', `${agentName} spawned successfully`);

      await new Promise(resolve => setTimeout(resolve, 400));
    }

    // Add user message to chat
    addMessage('user', userGoal);

    // Simulate agent work
    const workPhases = [
      { status: 'working', duration: 2000, message: 'Analyzing requirements...' },
      { status: 'working', duration: 1500, message: 'Processing data...' },
      { status: 'reviewing', duration: 1800, message: 'Reviewing output...' },
      { status: 'completed', duration: 500, message: 'Task completed' }
    ];

    // Update agents through phases
    for (const phase of workPhases) {
      setAgents(prev => prev.map(agent => ({
        ...agent,
        status: phase.status,
        task: phase.message
      })));

      // Add feed items
      const activeAgents = domainData.agents.slice(0, Math.min(3, domainData.agents.length));
      for (const agentName of activeAgents) {
        addFeedItem('agent', agentName, phase.message);
      }

      await new Promise(resolve => setTimeout(resolve, phase.duration));
    }

    // Generate output
    await new Promise(resolve => setTimeout(resolve, 1000));
    const generatedOutput = generateOutput(domainData, userGoal);
    setOutput(generatedOutput);

    // Add AI response to chat
    addMessage('ai', generatedOutput.summary);

    // Simulate agent termination
    addFeedItem('system', 'System', 'Workflow completed. Terminating agents...');

    for (let i = domainData.agents.length - 1; i >= 0; i--) {
      await new Promise(resolve => setTimeout(resolve, 200));
      terminateAgent(i);
    }

    setIsRunning(false);
  }, []);

  // Spawn agent
  const spawnAgent = (name, index) => {
    const color = AGENT_COLORS[name] || '#6366f1';
    const newAgent = {
      id: `agent-${Date.now()}-${index}`,
      name,
      status: 'idle',
      task: 'Waiting for task...',
      progress: 0,
      color,
      isNew: true
    };

    setAgents(prev => [...prev, newAgent]);

    // Remove spawn animation class after animation
    setTimeout(() => {
      setAgents(prev => prev.map(a =>
        a.id === newAgent.id ? { ...a, isNew: false } : a
      ));
    }, 600);
  };

  // Terminate agent
  const terminateAgent = (index) => {
    setAgents(prev => prev.map((agent, i) =>
      i === index ? { ...agent, status: 'terminating' } : agent
    ));

    setTimeout(() => {
      setAgents(prev => prev.filter((_, i) => i !== index));
    }, 400);
  };

  // Add feed item
  const addFeedItem = (type, agent, message) => {
    const timestamp = new Date().toLocaleTimeString('en-US', {
      hour12: false,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    });

    setFeedItems(prev => [...prev, { type, agent, message, timestamp, id: Date.now() }]);
  };

  // Add chat message
  const addMessage = (type, content) => {
    setMessages(prev => [...prev, {
      id: Date.now(),
      type,
      content,
      timestamp: new Date().toLocaleTimeString()
    }]);
  };

  // Generate output based on domain
  const generateOutput = (domain, goal) => {
    const outputs = {
      youtube: {
        title: 'YouTube Content Strategy',
        summary: `I've created a comprehensive YouTube strategy for: "${goal}". This includes video ideas, optimized titles, descriptions, and a content calendar.`,
        sections: [
          { title: 'Video Ideas', items: ['Top 5 video concepts aligned with your niche', 'Hook patterns for higher retention', 'SEO-optimized titles and descriptions'] },
          { title: 'Content Calendar', items: ['Weekly upload schedule', 'Thumbnail A/B testing plan', 'Community post strategy'] },
          { title: 'Growth Tactics', items: ['End screen optimization', 'Playlist strategy', 'Shorts cross-promotion'] }
        ]
      },
      content: {
        title: 'Content Marketing Campaign',
        summary: `I've developed a multi-channel content strategy for: "${goal}". This covers blog posts, social media, and email sequences.`,
        sections: [
          { title: 'Blog Content', items: ['SEO-optimized article outlines', 'Internal linking strategy', 'CTA placement recommendations'] },
          { title: 'Social Media', items: ['Platform-specific post templates', 'Hashtag research', 'Engagement optimization'] },
          { title: 'Email Sequence', items: ['Welcome series (5 emails)', 'Nurture sequence triggers', 'Conversion-optimized CTAs'] }
        ]
      },
      legal: {
        title: 'Legal Research Summary',
        summary: `I've compiled a comprehensive legal analysis for: "${goal}". This includes relevant statutes, case precedents, and compliance recommendations.`,
        sections: [
          { title: 'Applicable Laws', items: ['Federal regulations overview', 'State-specific requirements', 'Industry compliance standards'] },
          { title: 'Risk Assessment', items: ['Liability analysis', 'Mitigation strategies', 'Documentation requirements'] },
          { title: 'Recommended Actions', items: ['Immediate compliance steps', 'Policy updates needed', 'Review timeline'] }
        ]
      },
      development: {
        title: 'Technical Solution Design',
        summary: `I've created a detailed technical specification for: "${goal}". This includes architecture, implementation plan, and testing strategy.`,
        sections: [
          { title: 'Architecture', items: ['System design diagram', 'Database schema', 'API endpoints specification'] },
          { title: 'Implementation', items: ['Phased development roadmap', 'Tech stack recommendations', 'Code quality standards'] },
          { title: 'Testing & Deployment', items: ['Unit test coverage requirements', 'CI/CD pipeline design', 'Monitoring strategy'] }
        ]
      },
      research: {
        title: 'Research Report',
        summary: `I've conducted an in-depth research analysis on: "${goal}". This includes data synthesis, key findings, and actionable recommendations.`,
        sections: [
          { title: 'Key Findings', items: ['Primary research insights', 'Data visualization recommendations', 'Gap analysis'] },
          { title: 'Evidence Summary', items: ['Source credibility assessment', 'Statistical significance review', 'Contradiction analysis'] },
          { title: 'Recommendations', items: ['Strategic next steps', 'Further research needs', 'Implementation优先级'] }
        ]
      },
      business: {
        title: 'Business Strategy Report',
        summary: `I've developed a comprehensive business strategy for: "${goal}". This includes market analysis, competitive positioning, and execution roadmap.`,
        sections: [
          { title: 'Market Analysis', items: ['Target market sizing', 'Competitor landscape', 'Opportunity mapping'] },
          { title: 'Strategic Positioning', items: ['Unique value proposition', 'Go-to-market strategy', 'Revenue model'] },
          { title: 'Execution Plan', items: ['90-day action items', 'KPI framework', 'Risk mitigation strategies'] }
        ]
      }
    };

    return outputs[domain] || {
      title: 'Generated Output',
      summary: `Processing complete for: "${goal}"`,
      sections: [{ title: 'Results', items: ['Task completed successfully', 'Review for accuracy', 'Provide feedback for improvements'] }]
    };
  };

  // Handle launch
  const handleLaunch = () => {
    if (!selectedDomain || !goal.trim()) return;
    runSimulation(selectedDomain, goal);
  };

  // Clear feed
  const clearFeed = () => {
    setFeedItems([]);
  };

  // Copy output
  const copyOutput = () => {
    if (output) {
      const text = `${output.title}\n\n${output.summary}\n\n${output.sections.map(s => `${s.title}:\n${s.items.map(i => `- ${i}`).join('\n')}`).join('\n\n')}`;
      navigator.clipboard.writeText(text);
    }
  };

  // Select domain from dropdown
  const handleDomainSelect = (domainId) => {
    setSelectedDomain(domainId);
    setShowDomains(false);
    goalInputRef.current?.focus();
  };

  // Start new chat
  const startNewChat = () => {
    setAgents([]);
    setFeedItems([]);
    setMessages([]);
    setOutput(null);
    setGoal('');
    setSelectedDomain(null);
    setActiveChatId(null);
  };

  // Select chat from history
  const selectChat = (chatId) => {
    setActiveChatId(chatId);
  };

  // Get domain icon for history item
  const getHistoryIcon = (domainId) => {
    const domain = DOMAINS.find(d => d.id === domainId);
    return getDomainIcon(domain?.icon || 'sparkles');
  };

  return (
    <>
      {/* Mesh Gradient Background */}
      <div className="mesh-background">
        <div className="mesh-gradient" />
        <div className="mesh-orb mesh-orb-1" />
        <div className="mesh-orb mesh-orb-2" />
        <div className="mesh-orb mesh-orb-3" />
      </div>

      {/* Floating Sidebar Toggle (when sidebar is collapsed) */}
      <button
        className={`floating-sidebar-toggle ${!sidebarOpen ? 'visible' : ''}`}
        onClick={() => setSidebarOpen(true)}
      >
        {Icons.menu}
      </button>

      {/* Chat History Sidebar */}
      <aside className={`chat-sidebar ${sidebarOpen ? '' : 'collapsed'}`}>
        <div className="sidebar-header">
          <span className="sidebar-title">History</span>
          <button className="sidebar-toggle" onClick={() => setSidebarOpen(false)}>
            {Icons.chevronLeft}
          </button>
        </div>

        <div className="sidebar-search">
          <div className="search-input-wrapper">
            {Icons.search}
            <input
              type="text"
              className="search-input"
              placeholder="Search conversations..."
            />
          </div>
        </div>

        <div className="sidebar-new-chat">
          <button className="btn-new-chat" onClick={startNewChat}>
            {Icons.plus}
            New Chat
          </button>
        </div>

        <div className="sidebar-history">
          <div className="history-section">
            <div className="history-section-title">Recent</div>
            {chatHistory.map(chat => (
              <div
                key={chat.id}
                className={`history-item ${activeChatId === chat.id ? 'active' : ''}`}
                onClick={() => selectChat(chat.id)}
              >
                <div className="history-item-icon">
                  {getHistoryIcon(chat.domain)}
                </div>
                <div className="history-item-content">
                  <div className="history-item-title">{chat.title}</div>
                  <div className="history-item-meta">{chat.date}</div>
                </div>
                <div className="history-item-actions">
                  <button className="history-action-btn" title="Delete">
                    {Icons.trash}
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="sidebar-footer">
          <div className="sidebar-user">
            <div className="user-avatar">
              {Icons.user}
            </div>
            <div className="user-info">
              <div className="user-name">Demo User</div>
              <div className="user-plan">Free Plan</div>
            </div>
          </div>
        </div>
      </aside>

      {/* Main App Container */}
      <div className="app-container">
        {/* Main Content Area */}
        <main className="main-content">
          <nav className="nav-bar">
            <div className="nav-brand">
              <div className="nav-logo">
                {Icons.heart}
              </div>
              <span className="nav-brand-text">AI Agency</span>
            </div>

            <div className="nav-links">
              <button className="nav-link">Solutions</button>
              <button className="nav-link">Resources</button>
              <button className="nav-link">Community</button>
              <button className="nav-link">Enterprise</button>
              <button className="nav-link">Pricing</button>
            </div>

            <div className="nav-actions">
              <button className="btn-nav-secondary">Log in</button>
              <button className="btn-nav-primary">Get started</button>
            </div>

            <button className="nav-mobile-toggle">
              {Icons.menu}
            </button>
          </nav>

          {/* Hero Section with Central Prompt */}
          <section className="hero-section">
            <div className="hero-badge">
              <span>New:</span> Multi-Agent Collaboration System
            </div>

            <h1 className="hero-title">Build something extraordinary</h1>
            <p className="hero-subtitle">Assemble a team of specialized AI agents that collaborate in real-time to bring your ideas to life</p>

            {/* Central Prompt Input - Lovable Style */}
            <div className="central-prompt">
              <div className="prompt-input-wrapper">
                {/* Domain Selector */}
                <button
                  className="domain-selector"
                  onClick={() => setShowDomains(!showDomains)}
                >
                  <span className="domain-selector-icon">{Icons.sparkles}</span>
                  <span className="domain-selector-text">
                    {selectedDomain ? DOMAINS.find(d => d.id === selectedDomain)?.name : 'Select domain'}
                  </span>
                  <span className="domain-selector-chevron">{Icons.chevronDown}</span>
                </button>

                {/* Domain Dropdown */}
                {showDomains && (
                  <div className="domain-dropdown">
                    {DOMAINS.map(domain => (
                      <button
                        key={domain.id}
                        className={`domain-option ${selectedDomain === domain.id ? 'selected' : ''}`}
                        onClick={() => handleDomainSelect(domain.id)}
                      >
                        <div className="domain-option-icon" style={{ color: domain.color }}>
                          {getDomainIcon(domain.icon)}
                        </div>
                        <div className="domain-option-info">
                          <span className="domain-option-name">{domain.name}</span>
                          <span className="domain-option-agents">{domain.agents.length} agents</span>
                        </div>
                      </button>
                    ))}
                  </div>
                )}

                {/* Main Input */}
                <textarea
                  ref={goalInputRef}
                  className="prompt-input"
                  placeholder="Describe what you want to achieve... (e.g., 'Create a video about AI trends in 2025')"
                  value={goal}
                  onChange={(e) => setGoal(e.target.value)}
                  disabled={isRunning}
                  rows={3}
                />

                {/* Prompt Actions */}
                <div className="prompt-actions">
                  <button className="prompt-action" title="Attach files">
                    {Icons.plus}
                  </button>
                  <button className="prompt-action" title="Voice input">
                    {Icons.mic}
                  </button>
                  <button
                    className="prompt-submit"
                    onClick={handleLaunch}
                    disabled={!selectedDomain || !goal.trim() || isRunning}
                  >
                    {isRunning ? (
                      <div className="spinner" />
                    ) : (
                      <>
                        <span>Launch Team</span>
                        {Icons.zap}
                      </>
                    )}
                  </button>
                </div>
              </div>

              {/* Agent Count Hint */}
              {selectedDomain && (
                <div className="prompt-hint">
                  {DOMAINS.find(d => d.id === selectedDomain)?.agents.length} specialized agents ready to collaborate
                </div>
              )}
            </div>
          </section>

          {/* Agent Dashboard */}
          {agents.length > 0 && (
            <section className="agents-section">
              <div className="section-header">
                <div className="section-icon">
                  {Icons.users}
                </div>
                <div>
                  <h2 className="section-title">Agent Team Dashboard</h2>
                  <p className="section-subtitle">Real-time agent activity and status monitoring</p>
                </div>
              </div>

              <div className="agent-grid">
                {agents.map((agent, index) => (
                  <div
                    key={agent.id}
                    className={`agent-card ${agent.status} ${agent.isNew ? 'spawning' : ''}`}
                  >
                    <div className="agent-status">{agent.status}</div>
                    <div className="agent-header">
                      <div
                        className="agent-avatar"
                        style={{ backgroundColor: agent.color }}
                      >
                        {agent.name.split(' ').map(n => n[0]).join('')}
                      </div>
                      <div className="agent-info">
                        <h4>{agent.name}</h4>
                        <span>Agent #{index + 1}</span>
                      </div>
                    </div>
                    <p className="agent-task">{agent.task}</p>
                    <div className="agent-progress">
                      <div className="progress-bar">
                        <div
                          className="progress-fill"
                          style={{ width: agent.status === 'completed' ? '100%' : agent.status === 'working' ? '60%' : '20%' }}
                        />
                      </div>
                      <span className="progress-text">
                        {agent.status === 'completed' ? 'Complete' : agent.status === 'working' ? 'Processing...' : 'Initializing...'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* Live Feed Section */}
          {feedItems.length > 0 && (
            <section className="feed-section">
              <div className="feed-container">
                <div className="feed-header">
                  <div className="feed-title">
                    {Icons.terminal}
                    <h3>Live Agent Feed</h3>
                    <span className="feed-badge">Live</span>
                  </div>
                  <div className="feed-actions">
                    <button onClick={clearFeed} title="Clear feed">
                      {Icons.copy}
                    </button>
                  </div>
                </div>
                <div className="feed-content" ref={feedRef}>
                  {feedItems.map(item => (
                    <div key={item.id} className={`feed-item ${item.type}`}>
                      <span className="feed-timestamp">{item.timestamp}</span>
                      {item.agent !== 'System' && (
                        <span className="feed-agent">{item.agent}:</span>
                      )}
                      <span className="feed-message">{item.message}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          {/* Chat Interface */}
          <section className="chat-section">
            <div className="chat-container">
              <div className="chat-messages">
                {messages.length === 0 && (
                  <div className="chat-empty">
                    {Icons.bot}
                    <p>Your AI team is ready to collaborate</p>
                  </div>
                )}
                {messages.map(msg => (
                  <div key={msg.id} className={`chat-message ${msg.type}`}>
                    <div className={`message-avatar ${msg.type === 'user' ? 'user-avatar' : 'ai-avatar'}`}>
                      {msg.type === 'user' ? Icons.user : Icons.bot}
                    </div>
                    <div className="message-content">
                      <span className="message-sender">
                        {msg.type === 'user' ? 'You' : 'AI Agency Team'}
                      </span>
                      <div className="message-text">
                        {msg.content.split('\n').map((line, i) => (
                          <p key={i}>{line}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              <div className="chat-input-area">
                <div className="chat-input-wrapper">
                  <textarea
                    className="chat-input"
                    placeholder="Continue the conversation..."
                    rows={1}
                  />
                  <button className="btn-send" disabled>
                    {Icons.send}
                  </button>
                </div>
              </div>
            </div>
          </section>

          {/* Output Section */}
          {output && (
            <section className="output-section">
              <div className="output-container">
                <div className="output-header">
                  <div className="output-title">
                    {Icons.check}
                    <h3>Final Output</h3>
                  </div>
                  <span className="output-badge">Complete</span>
                </div>
                <div className="output-content">
                  <h2>{output.title}</h2>
                  <p>{output.summary}</p>
                  {output.sections.map((section, idx) => (
                    <div key={idx}>
                      <h3>{section.title}</h3>
                      <ul>
                        {section.items.map((item, i) => (
                          <li key={i}>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <div className="output-actions">
                  <button className="btn-action" onClick={copyOutput}>
                    {Icons.copy}
                    Copy to Clipboard
                  </button>
                  <button className="btn-action">
                    {Icons.download}
                    Export as PDF
                  </button>
                </div>
              </div>
            </section>
          )}
        </main>
      </div>
    </>
  );
}

export default App;