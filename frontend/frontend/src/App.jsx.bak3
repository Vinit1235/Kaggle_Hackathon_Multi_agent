  ),
  trash: (
    <svg viewBox="0 0 24 24" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="3 6 5 6 21 6" />
      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
    </svg>
  )
};

// Domain icon mapper
const getDomainIcon = (iconName) => Icons[iconName] || Icons.sparkles;

function App() {
  // State management
  const [selectedDomain, setSelectedDomain] = useState(null);
  const [goal, setGoal] = useState('');
  const [isRunning, setIsRunning] = useState(false);
  const [agents, setAgents] = useState([]);
  const [feedItems, setFeedItems] = useState([]);
  const [messages, setMessages] = useState([]);
  const [output, setOutput] = useState(null);
  const [showDomains, setShowDomains] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [domains, setDomains] = useState([]); // Populated from /api/domains
  const [, setSessionId] = useState(null);
  const [chatHistory, setChatHistory] = useState([]);
  const [activeChatId, setActiveChatId] = useState(null);
  const [chatInput, setChatInput] = useState('');
  const [toastMessage, setToastMessage] = useState(null);
  const [showAuthModal, setShowAuthModal] = useState(false);
  const [user, setUser] = useState(() => {
    try { return JSON.parse(localStorage.getItem('ai_agency_user')); } catch { return null; }
  });

  const feedRef = useRef(null);
  const goalInputRef = useRef(null);
  const wsRef = useRef(null);

  // Show toast helper
  const showToast = useCallback((msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3000);
  }, []);

  // Fetch domains on mount
  useEffect(() => {
    fetch('/api/domains')
      .then(res => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
      })
      .then(data => {
        const enhancedDomains = (data.domains || []).map(d => ({
          ...d,
          name: DOMAIN_META[d.id]?.name || d.id,
          icon: DOMAIN_META[d.id]?.icon || 'sparkles',
          color: DOMAIN_META[d.id]?.color || '#6366f1',
          agents: d.team_roles || []
        }));
        setDomains(enhancedDomains.length > 0 ? enhancedDomains : DOMAINS);
      })
      .catch(err => {
        console.error("Failed to fetch domains:", err);
        setDomains(DOMAINS); // Fallback to hardcoded
      });
  }, []);

  // Auto-scroll feed
  useEffect(() => {
    if (feedRef.current) {
      feedRef.current.scrollTop = feedRef.current.scrollHeight;
    }
  }, [feedItems]);



  const addFeedItem = useCallback((type, agent, message) => {
    const timestamp = new Date().toLocaleTimeString('en-US', {
      hour12: false,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    });

    setFeedItems(prev => [...prev, { type, agent, message, timestamp, id: Date.now() + Math.random() }]);
  }, []);

  const addMessage = useCallback((type, content) => {
    setMessages(prev => [...prev, {
      id: Date.now() + Math.random(),
      type,
      content,
      timestamp: new Date().toLocaleTimeString()
    }]);
  }, []);

  const updateAgentStatus = useCallback((agentName, status, task) => {
    setAgents(prev => {
      const existing = prev.find(a => a.name === agentName);
      if (existing) {
        return prev.map(a => a.name === agentName ? { ...a, status, task } : a);
      } else {
        const color = AGENT_COLORS[agentName] || '#6366f1';
        return [...prev, {
          id: `agent-${Date.now()}-${Math.random()}`,
          name: agentName,
          status,
          task,
          progress: status === 'completed' ? 100 : 50,
          color,
          isNew: true
        }];
      }
    });
  }, []);

  const handleWsEvent = useCallback((event) => {
    const agent = event.agent || 'System';
    const msg = event.message || '';

    switch (event.type) {
      case 'error':
        addFeedItem('error', agent, msg || 'An error occurred.');
        if (agent !== 'System') updateAgentStatus(agent, 'error', msg);
        break;

      case 'status':
        addFeedItem('system', agent, msg);
        if (agent !== 'System') updateAgentStatus(agent, 'working', msg);
        break;

      case 'task_complete':
        addFeedItem('success', agent, msg);
        if (agent !== 'System') updateAgentStatus(agent, 'completed', msg);
        break;

      case 'review':
        addFeedItem(
          event.verdict === 'approved' ? 'success' : 'warning',
          agent, msg
        );
        break;

      case 'final_output': {
        addFeedItem('success', agent, msg);
        const content = event.content || msg;
        setOutput({
          title: 'Final Deliverable',
          summary: 'The AI agency has finished processing your request.',
          sections: [{ title: 'Result', items: [content] }]
        });
        addMessage('ai', content.length > 500 ? content.substring(0, 500) + '...' : content);
        break;
      }

      case 'workflow_complete':
        addFeedItem('system', 'System', 'Workflow complete!');
        setIsRunning(false);
        wsRef.current?.close();
        break;

      // Fallback for any unrecognized event types
      default:
        addFeedItem('agent', agent, msg || JSON.stringify(event));
        if (agent !== 'System') updateAgentStatus(agent, 'working', msg);
        break;
    }
  }, [addFeedItem, addMessage, updateAgentStatus]);

  const connectWebSocket = useCallback((sid) => {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${window.location.host}/ws/${sid}`;
    
    if (wsRef.current) wsRef.current.close();
    
    const ws = new WebSocket(wsUrl);
    wsRef.current = ws;
    
    ws.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        handleWsEvent(data);
      } catch (err) {
        console.error("Failed to parse WS message", err, event.data);
      }
    };
    
    ws.onclose = () => {
      console.log("WebSocket closed");
      setIsRunning(false);
    };
  }, [handleWsEvent]);

  // Handle launch
  const handleLaunch = async () => {
    if (!selectedDomain || !goal.trim()) return;
    
    setIsRunning(true);
    setFeedItems([]);
    setAgents([]);
    setMessages([]);
    setOutput(null);

    addFeedItem('system', 'System', `Launching team for: "${goal}"`);
    addMessage('user', goal);

    // Save to chat history
    const historyEntry = {
      id: Date.now(),
      title: goal.length > 60 ? goal.substring(0, 60) + '...' : goal,
      date: 'Just now',
      domain: selectedDomain
    };
    setChatHistory(prev => [historyEntry, ...prev]);
    setActiveChatId(historyEntry.id);

    try {
      const response = await fetch('/api/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ domain: selectedDomain, user_goal: goal })
      });
      
      if (!response.ok) {
        const errBody = await response.text();
        throw new Error(`Backend error (${response.status}): ${errBody}`);
      }
      
      const data = await response.json();
      setSessionId(data.session_id);
      connectWebSocket(data.session_id);
    } catch (err) {
      console.error(err);
      addFeedItem('error', 'System', `Error: ${err.message}`);
      setIsRunning(false);
    }
  };

  // Clear feed
  const clearFeed = () => setFeedItems([]);

  // Delete a chat history item
  const deleteHistoryItem = (e, chatId) => {
    e.stopPropagation();
    setChatHistory(prev => prev.filter(c => c.id !== chatId));
    if (activeChatId === chatId) setActiveChatId(null);
  };

  // Export output as text file
  const exportOutput = () => {
    if (!output) return;
    const text = `${output.title}\n\n${output.summary}\n\n${output.sections.map(s => `${s.title}:\n${s.items.map(i => `- ${i}`).join('\n')}`).join('\n\n')}`;
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${output.title.replace(/\s+/g, '_')}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  // Handle chat follow-up send
  const handleChatSend = () => {
    if (!chatInput.trim()) return;
    addMessage('user', chatInput);
    addFeedItem('user', 'You', chatInput);
    // If there is an active session, we could re-run, but for now just echo
    addMessage('ai', 'Follow-up messaging will be available in a future update. Please start a new workflow for now.');
    setChatInput('');
  };

  // Auth handlers
  const handleLogin = (name) => {
    const userData = { name, plan: 'Free Plan' };
    setUser(userData);
    localStorage.setItem('ai_agency_user', JSON.stringify(userData));
    setShowAuthModal(false);
    showToast(`Welcome, ${name}!`);
  };

  const handleLogout = () => {
    setUser(null);
    localStorage.removeItem('ai_agency_user');
    showToast('Logged out successfully.');
  };

  // Copy output
  const copyOutput = () => {
    if (output) {
      const text = `${output.title}\n\n${output.summary}\n\n${output.sections.map(s => `${s.title}:\n${s.items.map(i => `- ${i}`).join('\n')}`).join('\n\n')}`;
      navigator.clipboard.writeText(text);
    }
  };

  // Select domain from dropdown
  const handleDomainSelect = (domainId) => {
    setSelectedDomain(domainId);
    setShowDomains(false);
    goalInputRef.current?.focus();
  };

  // Start new chat
  const startNewChat = () => {
    if (wsRef.current) wsRef.current.close();
    setAgents([]);
    setFeedItems([]);
    setMessages([]);
    setOutput(null);
    setGoal('');
    setSelectedDomain(null);
    setActiveChatId(null);
    setSessionId(null);
    setIsRunning(false);
  };

  // Select chat from history
  const selectChat = (chatId) => {
    setActiveChatId(chatId);
  };

  // Get domain icon for history item
  const getHistoryIcon = (domainId) => {
    const domain = domains.find(d => d.id === domainId);
    return getDomainIcon(domain?.icon || 'sparkles');
  };

  return (
    <>
      {/* Mesh Gradient Background */}
      <div className="mesh-background">
        <div className="mesh-gradient" />
        <div className="mesh-orb mesh-orb-1" />
        <div className="mesh-orb mesh-orb-2" />
        <div className="mesh-orb mesh-orb-3" />
      </div>

      {/* Floating Sidebar Toggle (when sidebar is collapsed) */}
      <button
        className={`floating-sidebar-toggle ${!sidebarOpen ? 'visible' : ''}`}
        onClick={() => setSidebarOpen(true)}
      >
        {Icons.menu}
      </button>

      {/* Chat History Sidebar */}
      <aside className={`chat-sidebar ${sidebarOpen ? '' : 'collapsed'}`}>
        <div className="sidebar-header">
          <span className="sidebar-title">History</span>
          <button className="sidebar-toggle" onClick={() => setSidebarOpen(false)}>
            {Icons.chevronLeft}
          </button>
        </div>

        <div className="sidebar-search">
          <div className="search-input-wrapper">
            {Icons.search}
            <input
              type="text"
              className="search-input"
              placeholder="Search conversations..."
            />
          </div>
        </div>

        <div className="sidebar-new-chat">
          <button className="btn-new-chat" onClick={startNewChat}>
            {Icons.plus}
            New Chat
          </button>
        </div>

        <div className="sidebar-history">
          <div className="history-section">
            <div className="history-section-title">Recent</div>
            {chatHistory.map(chat => (
              <div
                key={chat.id}
                className={`history-item ${activeChatId === chat.id ? 'active' : ''}`}
                onClick={() => selectChat(chat.id)}
              >
                <div className="history-item-icon">
                  {getHistoryIcon(chat.domain)}
                </div>
                <div className="history-item-content">
                  <div className="history-item-title">{chat.title}</div>
                  <div className="history-item-meta">{chat.date}</div>
                </div>
                <div className="history-item-actions">
                  <button className="history-action-btn" title="Delete" onClick={(e) => deleteHistoryItem(e, chat.id)}>
                    {Icons.trash}
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="sidebar-footer">
          <div className="sidebar-user" onClick={() => user ? handleLogout() : setShowAuthModal(true)}>
            <div className="user-avatar">
              {Icons.user}
            </div>
            <div className="user-info">
              <div className="user-name">{user?.name || 'Guest'}</div>
              <div className="user-plan">{user ? 'Click to log out' : 'Click to log in'}</div>
            </div>
          </div>
        </div>
      </aside>

      {/* Main App Container */}
      <div className={`app-container ${sidebarOpen ? '' : 'sidebar-collapsed'}`}>
        {/* Main Content Area */}
        <main className="main-content">
          <nav className="nav-bar">
            <div className="nav-brand">
              <div className="nav-logo">
                {Icons.heart}
              </div>
              <span className="nav-brand-text">AI Agency</span>
            </div>

            <div className="nav-links">
              <button className="nav-link" onClick={() => showToast('Solutions — coming soon')}>Solutions</button>
              <button className="nav-link" onClick={() => showToast('Resources — coming soon')}>Resources</button>
              <button className="nav-link" onClick={() => showToast('Community — coming soon')}>Community</button>
              <button className="nav-link" onClick={() => showToast('Enterprise — coming soon')}>Enterprise</button>
              <button className="nav-link" onClick={() => showToast('Pricing — coming soon')}>Pricing</button>
            </div>

            <div className="nav-actions">
              {user ? (
                <button className="btn-nav-secondary" onClick={handleLogout}>Log out</button>
              ) : (
                <>
                  <button className="btn-nav-secondary" onClick={() => setShowAuthModal(true)}>Log in</button>
                  <button className="btn-nav-primary" onClick={() => setShowAuthModal(true)}>Get started</button>
                </>
              )}
            </div>

            <button className="nav-mobile-toggle">
              {Icons.menu}
            </button>
          </nav>

          {/* Hero Section with Central Prompt */}
          <section className="hero-section">
            <div className="hero-badge">
              <span>New:</span> Multi-Agent Collaboration System
            </div>

            <h1 className="hero-title">Build something extraordinary</h1>
            <p className="hero-subtitle">Assemble a team of specialized AI agents that collaborate in real-time to bring your ideas to life</p>

            {/* Central Prompt Input - Lovable Style */}
            <div className="central-prompt">
              <div className="prompt-input-wrapper">
                {/* Domain Selector */}
                <button
                  className="domain-selector"
                  onClick={() => setShowDomains(!showDomains)}
                >
                  <span className="domain-selector-icon">{Icons.sparkles}</span>
                  <span className="domain-selector-text">
                    {selectedDomain ? domains.find(d => d.id === selectedDomain)?.name : 'Select domain'}
                  </span>
                  <span className="domain-selector-chevron">{Icons.chevronDown}</span>
                </button>

                {/* Domain Dropdown */}
                {showDomains && (
                  <div className="domain-dropdown">
                    {domains.map(domain => (
                      <button
                        key={domain.id}
                        className={`domain-option ${selectedDomain === domain.id ? 'selected' : ''}`}
                        onClick={() => handleDomainSelect(domain.id)}
                      >
                        <div className="domain-option-icon" style={{ color: domain.color }}>
                          {getDomainIcon(domain.icon)}
                        </div>
                        <div className="domain-option-info">
                          <span className="domain-option-name">{domain.name}</span>
                          <span className="domain-option-agents">{domain.agents.length} agents</span>
                        </div>
                      </button>
                    ))}
                  </div>
                )}

                {/* Main Input */}
                <textarea
                  ref={goalInputRef}
                  className="prompt-input"
                  placeholder="Describe what you want to achieve... (e.g., 'Create a video about AI trends in 2025')"
                  value={goal}
                  onChange={(e) => setGoal(e.target.value)}
                  disabled={isRunning}
                  rows={3}
                />

                {/* Prompt Actions */}
                <div className="prompt-actions">
                  <button className="prompt-action" title="Attach files" onClick={() => showToast('File attach — coming soon')}>
                    {Icons.plus}
                  </button>
                  <button className="prompt-action" title="Voice input" onClick={() => showToast('Voice input — coming soon')}>
                    {Icons.mic}
                  </button>
                  <button
                    className="prompt-submit"
                    onClick={handleLaunch}
                    disabled={!selectedDomain || !goal.trim() || isRunning}
                  >
                    {isRunning ? (
                      <div className="spinner" />
                    ) : (
                      <>
                        <span>Launch Team</span>
                        {Icons.zap}
                      </>
                    )}
                  </button>
                </div>
              </div>

              {/* Agent Count Hint */}
              {selectedDomain && (
                <div className="prompt-hint">
                  {domains.find(d => d.id === selectedDomain)?.agents?.length || 0} specialized agents ready to collaborate
                </div>
              )}
            </div>
          </section>

          {/* Agent Dashboard */}
          {agents.length > 0 && (
            <section className="agents-section">
              <div className="section-header">
                <div className="section-icon">
                  {Icons.users}
                </div>
                <div>
                  <h2 className="section-title">Agent Team Dashboard</h2>
                  <p className="section-subtitle">Real-time agent activity and status monitoring</p>
                </div>
              </div>

              <div className="agent-grid">
                {agents.map((agent, index) => (
                  <div
                    key={agent.id}
                    className={`agent-card ${agent.status} ${agent.isNew ? 'spawning' : ''}`}
                  >
                    <div className="agent-status">{agent.status}</div>
                    <div className="agent-header">
                      <div
                        className="agent-avatar"
                        style={{ backgroundColor: agent.color }}
                      >
                        {agent.name.split(' ').map(n => n[0]).join('')}
                      </div>
                      <div className="agent-info">
                        <h4>{agent.name}</h4>
                        <span>Agent #{index + 1}</span>
                      </div>
                    </div>
                    <p className="agent-task">{agent.task}</p>
                    <div className="agent-progress">
                      <div className="progress-bar">
                        <div
                          className="progress-fill"
                          style={{ width: agent.status === 'completed' ? '100%' : agent.status === 'working' ? '60%' : '20%' }}
                        />
                      </div>
                      <span className="progress-text">
                        {agent.status === 'completed' ? 'Complete' : agent.status === 'working' ? 'Processing...' : 'Initializing...'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* Live Feed Section */}
          {feedItems.length > 0 && (
            <section className="feed-section">
              <div className="feed-container">
                <div className="feed-header">
                  <div className="feed-title">
                    {Icons.terminal}
                    <h3>Live Agent Feed</h3>
                    <span className="feed-badge">Live</span>
                  </div>
                  <div className="feed-actions">
                    <button onClick={clearFeed} title="Clear feed">
                      {Icons.trash}
                    </button>
                  </div>
                </div>
                <div className="feed-content" ref={feedRef}>
                  {feedItems.map(item => (
                    <div key={item.id} className={`feed-item ${item.type}`}>
                      <span className="feed-timestamp">{item.timestamp}</span>
                      {item.agent !== 'System' && (
                        <span className="feed-agent">{item.agent}:</span>
                      )}
                      <span className="feed-message">{item.message}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          {/* Chat Interface */}
          <section className="chat-section">
            <div className="chat-container">
              <div className="chat-messages">
                {messages.length === 0 && (
                  <div className="chat-empty">
                    {Icons.bot}
                    <p>Your AI team is ready to collaborate</p>
                  </div>
                )}
                {messages.map(msg => (
                  <div key={msg.id} className={`chat-message ${msg.type}`}>
                    <div className={`message-avatar ${msg.type === 'user' ? 'user-avatar' : 'ai-avatar'}`}>
                      {msg.type === 'user' ? Icons.user : Icons.bot}
                    </div>
                    <div className="message-content">
                      <span className="message-sender">
                        {msg.type === 'user' ? 'You' : 'AI Agency Team'}
                      </span>
                      <div className="message-text">
                        {msg.content.split('\n').map((line, i) => (
                          <p key={i}>{line}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              <div className="chat-input-area">
                <div className="chat-input-wrapper">
                  <textarea
                    className="chat-input"
                    placeholder="Continue the conversation..."
                    rows={1}
                    value={chatInput}
                    onChange={(e) => setChatInput(e.target.value)}
                    onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleChatSend(); } }}
                  />
                  <button className="btn-send" onClick={handleChatSend} disabled={!chatInput.trim()}>
                    {Icons.send}
                  </button>
                </div>
              </div>
            </div>
          </section>

          {/* Output Section */}
          {output && (
            <section className="output-section">
              <div className="output-container">
                <div className="output-header">
                  <div className="output-title">
                    {Icons.check}
                    <h3>Final Output</h3>
                  </div>
                  <span className="output-badge">Complete</span>
                </div>
                <div className="output-content">
                  <h2>{output.title}</h2>
                  <p>{output.summary}</p>
                  {output.sections.map((section, idx) => (
                    <div key={idx}>
                      <h3>{section.title}</h3>
                      <ul>
                        {section.items.map((item, i) => (
                          <li key={i}>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <div className="output-actions">
                  <button className="btn-action" onClick={copyOutput}>
                    {Icons.copy}
                    Copy to Clipboard
                  </button>
                  <button className="btn-action" onClick={exportOutput}>
                    {Icons.download}
                    Export as Text
                  </button>
                </div>
              </div>
            </section>
          )}
        </main>
      </div>

      {/* Toast Notification */}
      {toastMessage && (
        <div className="toast-notification">
          {toastMessage}
        </div>
      )}

      {/* Auth Modal */}
      {showAuthModal && (
        <div className="modal-overlay" onClick={() => setShowAuthModal(false)}>
          <div className="modal-content" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h3>Welcome to AI Agency</h3>
              <button className="modal-close" onClick={() => setShowAuthModal(false)}>{Icons.x}</button>
            </div>
            <form onSubmit={(e) => {
              e.preventDefault();
              const name = e.target.elements.name.value.trim();
              if (name) handleLogin(name);
            }}>
              <input
                name="name"
                type="text"
                className="modal-input"
                placeholder="Enter your name"
                autoFocus
                required
              />
              <button type="submit" className="modal-submit">Continue</button>
            </form>
          </div>
        </div>
      )}
    </>
  );
}

export default App;