# ============================================================
# AI Agency Platform - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- LLM (Gemini API — Free, no credit card) ---
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini
GEMINI_LIGHT_MODEL=gemini-2.0-flash
GEMINI_HEAVY_MODEL=gemini-2.5-flash

# --- Ollama (Local Dev Fallback — not needed on cloud) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Database (Supabase PostgreSQL) ---
# Get this from Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- SQLite (Local Dev Fallback — used when DATABASE_URL is empty) ---
SQLITE_DB_PATH=./data/taskbox.db

# --- Redis (Upstash REST API — Free, no credit card) ---
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Or standard Redis URL for local dev:
# REDIS_URL=redis://localhost:6379/0

# --- Vector DB (Pinecone — Free, no credit card) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=agency-rag

# --- Memory / RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.50

# --- Model Router ---
COMPLEXITY_THRESHOLD=0.6

# --- Security ---
ENABLE_PII_SHIELD=false
# Set to true only if presidio is installed (heavy dependency, ~800MB)
