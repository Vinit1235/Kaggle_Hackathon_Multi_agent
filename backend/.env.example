# ============================================================
# AI Agency Platform - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Ollama (Local Inference) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:e2b
OLLAMA_HEAVY_MODEL=gemma4:26b-moe

# --- Google Cloud / Vertex AI (Cloud Inference) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemma-4-31b-dense

# --- Redis (memX State Sync) ---
REDIS_URL=redis://localhost:6379/0
# Or Upstash Free Tier:
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# --- SQLite (Taskbox) ---
SQLITE_DB_PATH=./data/taskbox.db

# --- Memory / RAG ---
FAISS_INDEX_PATH=./data/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.50

# --- Model Router ---
COMPLEXITY_THRESHOLD=0.6
# Above this → route to cloud (Vertex AI)
# Below this → route to local (Ollama)

# --- Security ---
ENABLE_PII_SHIELD=true
